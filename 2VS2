                {
                    int VidaCurada = VidaGladiador2 + 5;
                    return VidaCurada;
                }
                else
                {
                    int Curacion = VidaMaxima - VidaGladiador2;
                    int VidaCurada = VidaGladiador2 + Curacion;
                    return VidaCurada;
                }
            }
            else
