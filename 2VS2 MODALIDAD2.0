                                    PV_A_b = 0;
                                }
                                Total_daño_Ba = Puntos + Total_daño_Ba;
                                Console.WriteLine("Ataca " + Gladiador1_Equi2 + " a " + Gladiador2_Equi1 + "...");
                                Console.WriteLine();
                                Console.WriteLine("Gladiador2 queda con " + PV_A_b + " puntos de vida.");
                                Console.WriteLine("Gladiador2 suma " + Puntos + " puntos.");
                                Console.WriteLine();
                                if (PV_A_b == 0)
                                {
                                    Console.WriteLine("El jugador " + Gladiador2_Equi1 + " queda inhabilitado y fuera de combate y no se lo puede usar mas.");
                                }
                            }
                            else if (atacaNum == 2 && objetivoNum == 1)
                            {
                                int Vida_1antes = PV_A_a;
                                PV_A_a = Ataque_ju1(ATK_B_b, ATK_A_a, PV_B_b, PV_A_a, DEF_B_b, DEF_A_a, turno);
                                int Puntos = Vida_1antes - PV_A_a;
                                if (PV_A_a == Vida_1antes)
                                {
                                    Puntos = Vida_1antes;
                                    Vida_1antes = 0;
                                    PV_A_a = 0;
                                }
                                Total_daño_Bb = Puntos + Total_daño_Bb;
                                Console.WriteLine("Ataca " + Gladiador2_Equi2 + " a " + Gladiador1_Equi1 + "...");
                                Console.WriteLine();
                                Console.WriteLine("Gladiador1 queda con " + PV_A_a + " puntos de vida.");
                                Console.WriteLine("Gladiador2 suma " + Puntos + " puntos.");
                                Console.WriteLine();
                                if (PV_A_a == 0)
                                {
                                    Console.WriteLine("El jugador " + Gladiador1_Equi1 + " queda inhabilitado y fuera de combate y no se lo puede usar mas.");
                                }
                            }
                            else if (atacaNum == 2 && objetivoNum == 2)
                            {
                                int Vida_3antes = PV_A_b;
                                PV_A_b = Ataque_ju1(ATK_B_b, ATK_A_b, PV_B_b, PV_A_b, DEF_B_b, DEF_A_b, turno);
                                int Puntos = Vida_3antes - PV_A_b;
                                if (PV_A_b == Vida_3antes)
                                {
                                    Puntos = Vida_3antes;
                                    Vida_3antes = 0;
                                    PV_A_b = 0;
                                }
                                Total_daño_Bb = Puntos + Total_daño_Bb;
                                Console.WriteLine("Ataca " + Gladiador2_Equi2 + " a " + Gladiador2_Equi1 + "...");
                                Console.WriteLine();
                                Console.WriteLine("Gladiador2 queda con " + PV_A_b + " puntos de vida.");
                                Console.WriteLine("Gladiador2 suma " + Puntos + " puntos.");
                                Console.WriteLine();
                                if (PV_A_b == 0)
                                {
                                    Console.WriteLine("El jugador " + Gladiador2_Equi1 + " queda inhabilitado y fuera de combate y no se lo puede usar mas.");
                                }
                            }
                        }
                        else
                        {
                            Console.WriteLine("¿Qué gladiador de " + Nom_Equi1 + " ataca? (1: " + Gladiador1_Equi1 + " / 2: " + Gladiador2_Equi1 + ")");
                            int atacaNum = int.Parse(Console.ReadLine());
                            while ((atacaNum == 1 && PV_A_a <= 0) || (atacaNum == 2 && PV_A_b <= 0))
                            {
                                if (atacaNum == 1 && PV_A_a <= 0)
                                {
                                    Console.WriteLine("El jugador " + Gladiador1_Equi1 + " queda inhabilitado y fuera de combate y no se lo puede usar mas.");
                                }
                                if (atacaNum == 2 && PV_A_b <= 0)
                                {
                                    Console.WriteLine("El jugador " + Gladiador2_Equi1 + " queda inhabilitado y fuera de combate y no se lo puede usar mas.");
                                }
                                Console.WriteLine("¿Qué gladiador de " + Nom_Equi1 + " ataca? (1: " + Gladiador1_Equi1 + " / 2: " + Gladiador2_Equi1 + ")");
                                atacaNum = int.Parse(Console.ReadLine());
                            }

                            Console.WriteLine("¿A quién del equipo rival (" + Nom_Equi2 + ") deseas atacar? (1: " + Gladiador1_Equi2 + " / 2: " + Gladiador2_Equi2 + ")");
                            int objetivoNum = int.Parse(Console.ReadLine());
                            while ((objetivoNum == 1 && PV_B_a <= 0) || (objetivoNum == 2 && PV_B_b <= 0))
                            {
                                if (objetivoNum == 1 && PV_B_a <= 0)
                                {
                                    Console.WriteLine("No se le puede atacar a " + Gladiador1_Equi2 + " porque quedó fuera de combate e inhabilitado.");
                                }
                                if (objetivoNum == 2 && PV_B_b <= 0)
                                {
                                    Console.WriteLine("No se le puede atacar a " + Gladiador2_Equi2 + " porque quedó fuera de combate e inhabilitado.");
                                }
                                Console.WriteLine("¿A quién del equipo rival (" + Nom_Equi2 + ") deseas atacar? (1: " + Gladiador1_Equi2 + " / 2: " + Gladiador2_Equi2 + ")");
                                objetivoNum = int.Parse(Console.ReadLine());
                            }

                            if (atacaNum == 1 && objetivoNum == 1)
                            {
                                int Vida_2antes = PV_B_a;
                                PV_B_a = Ataque_ju1(ATK_A_a, ATK_B_a, PV_B_a, PV_A_a, DEF_A_a, DEF_B_a, turno);
                                int Puntos = Vida_2antes - PV_B_a;
                                if (PV_B_a == Vida_2antes)
                                {
                                    Puntos = Vida_2antes;
                                    Vida_2antes = 0;
                                    PV_B_a = 0;
                                }
                                Total_daño_Aa = Puntos + Total_daño_Aa;
                                Console.WriteLine("Ataca " + Gladiador1_Equi1 + " a " + Gladiador1_Equi2 + "...");
                                Console.WriteLine();
                                Console.WriteLine("Gladiador2 queda con " + PV_B_a + " puntos de vida.");
                                Console.WriteLine("Gladiador1 suma " + Puntos + " puntos.");
                                Console.WriteLine();
                                if (PV_B_a == 0)
                                {
                                    Console.WriteLine("El jugador " + Gladiador1_Equi2 + " queda inhabilitado y fuera de combate y no se lo puede usar mas.");
                                }
                            }
                            else if (atacaNum == 1 && objetivoNum == 2)
                            {
                                int Vida_4antes = PV_B_b;
                                PV_B_b = Ataque_ju1(ATK_A_a, ATK_B_b, PV_B_b, PV_A_a, DEF_A_a, DEF_B_b, turno);
                                int Puntos = Vida_4antes - PV_B_b;
                                if (PV_B_b == Vida_4antes)
                                {
                                    Puntos = Vida_4antes;
                                    Vida_4antes = 0;
                                    PV_B_b = 0;
                                }
                                Total_daño_Aa = Puntos + Total_daño_Aa;
                                Console.WriteLine("Ataca " + Gladiador1_Equi1 + " a " + Gladiador2_Equi2 + "...");
                                Console.WriteLine();
                                Console.WriteLine("Gladiador2 queda con " + PV_B_b + " puntos de vida.");
                                Console.WriteLine("Gladiador1 suma " + Puntos + " puntos.");
                                Console.WriteLine();
                                if (PV_B_b == 0)
                                {
                                    Console.WriteLine("El jugador " + Gladiador2_Equi2 + " queda inhabilitado y fuera de combate y no se lo puede usar mas.");
                                }
                            }
                            else if (atacaNum == 2 && objetivoNum == 1)
                            {
                                int Vida_2antes = PV_B_a;
                                PV_B_a = Ataque_ju1(ATK_A_b, ATK_B_a, PV_B_a, PV_A_b, DEF_A_b, DEF_B_a, turno);
                                int Puntos = Vida_2antes - PV_B_a;
                                if (PV_B_a == Vida_2antes)
                                {
                                    Puntos = Vida_2antes;
                                    Vida_2antes = 0;
                                    PV_B_a = 0;
                                }
                                Total_daño_Ab = Puntos + Total_daño_Ab;
                                Console.WriteLine("Ataca " + Gladiador2_Equi1 + " a " + Gladiador1_Equi2 + "...");
                                Console.WriteLine();
                                Console.WriteLine("Gladiador2 queda con " + PV_B_a + " puntos de vida.");
                                Console.WriteLine("Gladiador1 suma " + Puntos + " puntos.");
                                Console.WriteLine();
                                if (PV_B_a == 0)
                                {
                                    Console.WriteLine("El jugador " + Gladiador1_Equi2 + " queda inhabilitado y fuera de combate y no se lo puede usar mas.");
                                }
                            }
                            else if (atacaNum == 2 && objetivoNum == 2)
                            {
                                int Vida_4antes = PV_B_b;
                                PV_B_b = Ataque_ju1(ATK_A_b, ATK_B_b, PV_B_b, PV_A_b, DEF_A_b, DEF_B_b, turno);
                                int Puntos = Vida_4antes - PV_B_b;
                                if (PV_B_b == Vida_4antes)
                                {
                                    Puntos = Vida_4antes;
                                    Vida_4antes = 0;
                                    PV_B_b = 0;
                                }
                                Total_daño_Ab = Puntos + Total_daño_Ab;
                                Console.WriteLine("Ataca " + Gladiador2_Equi1 + " a " + Gladiador2_Equi2 + "...");
                                Console.WriteLine();
                                Console.WriteLine("Gladiador2 queda con " + PV_B_b + " puntos de vida.");
                                Console.WriteLine("Gladiador1 suma " + Puntos + " puntos.");
                                Console.WriteLine();
                                if (PV_B_b == 0)
                                {
                                    Console.WriteLine("El jugador " + Gladiador2_Equi2 + " queda inhabilitado y fuera de combate y no se lo puede usar mas.");
                                }
                            }
                        }
                        break;

                    case 2:
                        {
                            if (contadorRecuperar <= 2)
                            {
                                contadorRecuperar++;
                                int VidaCurada = RecuperarVida(PV_A_a, PV_B_a, VidaMaxima, turno);
                                if (turno % 2 == 0)
                                {
                                    PV_B_a = VidaCurada;
                                }
                                else
                                {
                                    PV_A_a = VidaCurada;
                                }
                                Console.WriteLine("La vida del gladiador ahora es de " + VidaCurada + " puntos de vida.");
                                break;
                            }
                            else
                            {
                                Console.WriteLine("Un gladiador no puede recuperar vida más de dos veces por combate.");
                                break;
                            }
                        }

                    default:
                        Console.WriteLine("Opción no válida. Intente de nuevo.");
                        break;
                }
                turno++;
            }

            int turnosTotales = turno - 1;
            PV_equipo1_Total = PV_A_a + PV_A_b;
            PV_equipo2_Total = PV_B_a + PV_B_b;

            Console.WriteLine("====================GAME OVER====================");
            if (PV_equipo1_Total > 0)
            {
                Console.WriteLine("El combate ha acabado... Ganan " + Nom_Equi1 + " en " + turnosTotales + " turnos.");
            }
            else
            {
                Console.WriteLine("El combate ha acabado... Ganan " + Nom_Equi2 + " en " + turnosTotales + " turnos.");
            }

            MVP = Total_daño_Aa;
            string nombreMVP = Gladiador1_Equi1;
            if (Total_daño_Ab > MVP)
            {
                MVP = Total_daño_Ab;
                nombreMVP = Gladiador2_Equi1;
            }
            if (Total_daño_Ba > MVP)
            {
                MVP = Total_daño_Ba;
                nombreMVP = Gladiador1_Equi2;
            }
            if (Total_daño_Bb > MVP)
            {
                MVP = Total_daño_Bb;
                nombreMVP = Gladiador2_Equi2;
            }
            Console.WriteLine("MVP del torneo (" + MVP + " de daño causado): " + nombreMVP);

            if (PV_equipo1_Total > 0)
            {
                double promedio = (PV_A_a + PV_A_b) / 2.0;
                int enPie = 0;
                if (PV_A_a > 0)
                {
                    enPie = enPie + 1;
                }
                if (PV_A_b > 0)
                {
                    enPie = enPie + 1;
                }
                Console.WriteLine("Promedio de vida restante de " + Nom_Equi1 + ": " + promedio.ToString("0.00") + " (sobrevivientes: " + enPie + " de " + Modalidad + ")");
            }
            else
            {
                double promedio = (PV_B_a + PV_B_b) / 2.0;
                int enPie = 0;
                if (PV_B_a > 0)
                {
                    enPie = enPie + 1;
                }
                if (PV_B_b > 0)
                {
                    enPie = enPie + 1;
                }
                Console.WriteLine("Promedio de vida restante de " + Nom_Equi2 + ": " + promedio.ToString("0.00") + " (sobrevivientes: " + enPie + " de " + Modalidad + ")");
            }

            string estadogla1;
            if (PV_A_a > 0)
            {
                estadogla1 = "de pie";
            }
            else
            {
                estadogla1 = "fuera de combate";
            }

            string estadogla2;
            if (PV_A_b > 0)
            {
                estadogla2 = "de pie";
            }
            else
            {
                estadogla2 = "fuera de combate";
            }

            string estadogla3;
            if (PV_B_a > 0)
            {
                estadogla3 = "de pie";
            }
            else
            {
                estadogla3 = "fuera de combate";
            }

            string estadogla4;
            if (PV_B_b > 0)
            {
                estadogla4 = "de pie";
            }
            else
            {
                estadogla4 = "fuera de combate";
            }

            Console.WriteLine();
            Console.WriteLine("Equipo: " + Nom_Equi1 + "     " + "NOMBRE: " + Gladiador1_Equi1 + "     " + "VIDA: " + PV_A_a + "/" + VidaMaxima + "     " + "ATQ: " + ATK_A_a + "     " + "DEF: " + DEF_A_a + "     " + "DAÑO CAUSADO: " + Total_daño_Aa + "     " + "ESTADO: " + estadogla1);
            Console.WriteLine("Equipo: " + Nom_Equi1 + "     " + "NOMBRE: " + Gladiador2_Equi1 + "     " + "VIDA: " + PV_A_b + "/" + VidaMaxima + "     " + "ATQ: " + ATK_A_b + "     " + "DEF: " + DEF_A_b + "     " + "DAÑO CAUSADO: " + Total_daño_Ab + "     " + "ESTADO: " + estadogla2);
            Console.WriteLine("Equipo: " + Nom_Equi2 + "     " + "NOMBRE: " + Gladiador1_Equi2 + "     " + "VIDA: " + PV_B_a + "/" + VidaMaxima + "     " + "ATQ: " + ATK_B_a + "     " + "DEF: " + DEF_B_a + "     " + "DAÑO CAUSADO: " + Total_daño_Ba + "     " + "ESTADO: " + estadogla3);
            Console.WriteLine("Equipo: " + Nom_Equi2 + "     " + "NOMBRE: " + Gladiador2_Equi2 + "     " + "VIDA: " + PV_B_b + "/" + VidaMaxima + "     " + "ATQ: " + ATK_B_b + "     " + "DEF: " + DEF_B_b + "     " + "DAÑO CAUSADO: " + Total_daño_Bb + "     " + "ESTADO: " + estadogla4);
        }
    }
}
