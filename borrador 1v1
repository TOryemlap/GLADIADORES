using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ConsoleApplication1
{
    class Program
    {
        static void Main()
        {
            int Vida_2 = 18;
            int Ataque1 = 15;
            int defen2 = 5;
            int Vida_2antes = Vida_2;
            Vida_2 = Ataque_ju1(Vida_2, Ataque1, defen2);
            Vida_2antes = Vida_2antes - Vida_2;
            Console.WriteLine("le queda " + Vida_2 + " puntos de vida al jugador 2 y al atacante se le suma " + Vida_2antes + " puntos");

        }
        static int Ataque_ju1(int Vida_2, int Ataque1, int defen2)
        {
            if (Vida_2 > 0)
            {
                Ataque1 = Ataque1 - defen2;
                if (Ataque1 < 1)
                {
                    Ataque1 = 1;
                }
                if (Ataque1 > Vida_2)
                {
                    Vida_2 = 0;
                    Ataque1 = Vida_2;
                }
                else
                {
                    Vida_2 = Vida_2 - Ataque1;
                }
            }

            return Vida_2;
        }
    }
}
